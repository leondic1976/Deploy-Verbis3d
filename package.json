{
  "name": "@verbis3d/core",
  "version": "0.4.0-alpha.1",
  "private": false,
  "description": "AI-native WebGL2 3D engine implemented directly in TypeScript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "docs:api": "typedoc",
    "site:build": "vite build && node scripts/copy-api.mjs",
    "site:check": "node scripts/check-site-links.mjs",
    "site:dev": "vite"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leondic1976/Deploy-Verbis3d.git"
  },
  "bugs": {
    "url": "https://github.com/leondic1976/Deploy-Verbis3d/issues"
  },
  "homepage": "https://leondic1976.github.io/Deploy-Verbis3d/"
}
